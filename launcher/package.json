{
  "name": "launcher",
  "productName": "Galaxy Launcher",
  "description": "A custom launcher for Minecraft: Java Edition.",
  "author": "Galaxy Launcher",
  "homepage": "https://github.com/Mrdudidj/galaxy-launcher",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.galaxylauncher.app",
    "productName": "Galaxy Launcher",
    "directories": {
      "output": "release"
    },
    "files": ["out/**/*", "resources/**/*", "package.json"],
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "resources/icon.png",
      "category": "Game",
      "maintainer": "Galaxy Launcher",
      "artifactName": "galaxy-launcher-${version}-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "galaxy-launcher_${version}_${arch}.${ext}"
    },
    "win": {
      "target": ["nsis"],
      "icon": "resources/icon.png",
      "artifactName": "galaxy-launcher-setup-${version}.${ext}",
      "extraResources": [
        {
          "from": "../windows-helper/bin/Release/net8.0-windows10.0.19041.0/win-x64/publish/GalaxyMediaHelper.exe",
          "to": "windows-helper/GalaxyMediaHelper.exe"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.156.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@azure/msal-node": "^6.0.0",
    "@galaxy-launcher/shared-types": "workspace:*",
    "@tanstack/react-query": "^5.102.8",
    "@xhayper/discord-rpc": "^1.3.4",
    "@xmcl/core": "^2.15.1",
    "@xmcl/installer": "^6.1.2",
    "@xmcl/task": "^4.1.1",
    "@xmcl/unzip": "2.2.0",
    "@xmcl/user": "^4.4.2",
    "dbus-next": "^0.10.2",
    "dotenv": "^17.4.2",
    "prismarine-nbt": "^2.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "skinview3d": "^3.4.2",
    "three": "^0.156.1",
    "zustand": "^5.0.15"
  }
}
